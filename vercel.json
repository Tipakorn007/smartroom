{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/**/*.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    },
    {
      "source": "/checkin/:token",
      "destination": "/index.html"
    }
  ]
}
