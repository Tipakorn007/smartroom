{
  "name": "smartroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "SmartRoom — ระบบจองห้องติวหนังสือที่รู้สถานะห้องจากการใช้งานจริง (Bun + Neon Postgres)",
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "dev": "bun run build && bun --watch ./scripts/dev-demo.ts",
    "dev:database": "bun run build && bun --watch ./src/server/index.ts",
    "start": "bun run build && bun ./src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/functions": "^3.11.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.3"
  }
}
